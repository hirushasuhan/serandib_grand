# Application internals — never directly reachable over HTTP.
# Placed INSIDE the folder so protection does not depend on the project
# folder name or install path (the old root-level RedirectMatch rule did,
# and silently failed because the app lives in a subdirectory).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

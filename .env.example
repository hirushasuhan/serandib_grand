# ── Application ──
APP_ENV=production
APP_NAME="Serendib Grand Hotel"
BASE_URL="https://serandib-grand.wasmer.app"

# ── Cloud MySQL Database ──
# (Wasmer Edge cannot run a local MySQL service, so point to a cloud MySQL instance)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_reservation_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSL=false
